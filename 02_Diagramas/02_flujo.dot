digraph G {
rankdir=TB;
graph [fontname="Helvetica", fontsize=12, nodesep=0.45, ranksep=0.45];
node [fontname="Helvetica", fontsize=10, style="rounded,filled", fillcolor="#eaf2f8", color="#1f4e79"];
edge [fontname="Helvetica", fontsize=9];
a [shape=ellipse, label="Inicio"];
b [shape=box, label="Cargar base de conocimientos"];
c [shape=box, label="Estado IDLE: esperar botón o aplauso"];
d [shape=diamond, label="¿Activación detectada?"];
e [shape=box, label="Estado SEQUENCE: generar / ampliar secuencia"];
f [shape=box, label="Mostrar secuencia: LEDs + OLED + audio"];
g [shape=box, label="Estado USER_INPUT: esperar respuesta"];
h [shape=diamond, label="¿Coincide la entrada?"];
i [shape=diamond, label="¿Secuencia completa?"];
j [shape=box, label="Ronda superada: aumentar nivel / velocidad"];
k [shape=box, label="Error: notificar, registrar puntaje y reset"];
a->b->c->d; d->e [label="Sí"]; d->c [label="No"]; e->f->g->h; h->i [label="Sí"]; h->k [label="No"]; i->g [label="No"]; i->j [label="Sí"]; j->e; k->c;
}