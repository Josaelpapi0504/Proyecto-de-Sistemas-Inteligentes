digraph G {
rankdir=TB;
graph [fontname="Helvetica", fontsize=12, nodesep=0.5, ranksep=0.5];
node [fontname="Helvetica", fontsize=10, style="rounded,filled", fillcolor="#fdf2e9", color="#a04000"];
edge [fontname="Helvetica", fontsize=9];
start [shape=circle, label="", width=0.3, style=filled, fillcolor=black];
a [label="Inicializar controladores"];
b [label="Limpiar LEDs y pantalla"];
c [label="Esperar inicio"];
d [shape=diamond, label="¿Botón o aplauso?"];
e [label="Reproducir patrón de la ronda"];
f [label="Esperar respuesta del jugador"];
g [shape=diamond, label="¿Entrada válida?"];
h [shape=diamond, label="¿Completa la ronda?"];
i [label="Incrementar dificultad"];
j [label="Mostrar error y reiniciar"];
start->a->b->c->d; d->e [label="Sí"]; d->c [label="No"]; e->f->g; g->h [label="Sí"]; g->j [label="No"]; h->f [label="No"]; h->i [label="Sí"]; i->e; j->c;
}